rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Block all access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Per-user isolated storage
    match /users/{userId}/{allPaths=**} {

      // Allow authenticated users to read only their own files
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to write only their own files with constraints
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   // Maximum file size: 20 MB per file
                   && request.resource.size < 20 * 1024 * 1024
                   // Only allow PDF and image file types
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('image/jpeg')
                       || request.resource.contentType.matches('image/png')
                       || request.resource.contentType.matches('image/webp'));

      // Allow delete of own files
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
